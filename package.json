{
  "name": "miloshophand",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,worker \"npm run dev -w @milo/api\" \"npm run dev -w @milo/web\" \"npm run dev -w @milo/worker\"",
    "start": "concurrently -k -n api,web,worker \"npm run start -w @milo/api\" \"npm run start -w @milo/web\" \"npm run start -w @milo/worker\"",
    "build": "npm run build -w @milo/shared && npm run build -w @milo/api && npm run build -w @milo/worker && npm run build -w @milo/web",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/worker && tsc --noEmit -p apps/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:collection": "tsx prisma/collection.ts",
    "assets:models": "node scripts/build-collection-models.mjs && node scripts/build-legacy-models.mjs && node scripts/render-legacy-images.mjs",
    "assets:verify": "node scripts/verify-collection.mjs",
    "assets:brand": "node scripts/build-branded-colorways.mjs",
    "assets:brand:verify": "node scripts/verify-branded-colorways.mjs",
    "db:seed:brand": "tsx prisma/brand-variants.ts",
    "db:seed:photos": "tsx prisma/photo-presentation.ts",
    "db:polo:plan": "tsx prisma/polo.ts",
    "db:seed:polo": "tsx prisma/polo.ts --apply",
    "db:polo:publish-preview": "tsx prisma/polo.ts --publish-preview",
    "db:polo:publish-sale": "tsx prisma/polo.ts --publish-sale --sale-config prisma/polo-sale.json",
    "assets:polo:preview": "node scripts/build-polo-preview.mjs",
    "admin:create": "tsx --tsconfig apps/api/tsconfig.json scripts/admin.ts",
    "admin:grant": "tsx --tsconfig apps/api/tsconfig.json scripts/admin.ts --grant",
    "setup": "node scripts/setup.mjs",
    "test": "tsx --test tests/domain.test.ts tests/media.test.ts tests/photo-spin.test.ts tests/display-spin.test.ts tests/garment-palette.test.ts tests/try-on.test.ts tests/try-on-api.test.ts tests/security.test.ts tests/polo-catalog.test.ts && node --test tests/sync-project.test.mjs tests/garment-geometry.test.mjs tests/local-services.test.mjs",
    "assets:rotation:verify": "tsx scripts/audit-rotation-coverage.ts --require-all",
    "assets:rotation:smoke": "node scripts/smoke-rotation-coverage.mjs",
    "assets:photos": "node scripts/build-photo-spin-manifest.mjs && node scripts/build-product-media.mjs",
    "assets:media": "node scripts/build-product-media.mjs",
    "assets:media:verify": "tsx scripts/verify-product-media.ts",
    "assets:photos:verify": "tsx scripts/verify-photo-spins.ts",
    "assets:photos:smoke": "node scripts/smoke-photo-spins.mjs && node scripts/smoke-product-media.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "security:scan": "node scripts/security-scan.mjs --history",
    "test:security": "tsx --test tests/security.test.ts && node scripts/test-integration.mjs",
    "test:e2e": "node scripts/redesign-preview.mjs --test",
    "test:try-on": "node scripts/test-try-on.mjs",
    "test:try-on:api": "node scripts/test-try-on-api.mjs",
    "test:commerce-upgrade": "node scripts/test-try-on-api.mjs --commerce",
    "test:seller-ops": "node scripts/test-try-on-api.mjs --seller-ops",
    "test:auth-upgrade": "node scripts/test-try-on-api.mjs --auth-upgrade",
    "test:fulfillment": "node scripts/test-try-on-api.mjs --fulfillment",
    "test:shopping-growth": "node scripts/test-try-on-api.mjs --shopping-growth",
    "test:e2e:production": "node scripts/redesign-preview.mjs --production --test",
    "dev:preview": "node scripts/redesign-preview.mjs",
    "db:local": "node scripts/local-db.mjs",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait postgres redis",
    "infra:configure-local": "node scripts/configure-local-services.mjs",
    "infra:stop": "docker compose --env-file .env -f infra/compose.yaml stop postgres redis",
    "infra:status": "docker compose --env-file .env -f infra/compose.yaml ps postgres redis",
    "infra:logs": "docker compose --env-file .env -f infra/compose.yaml logs --tail=100 postgres redis",
    "db:backup": "node scripts/docker-db.mjs backup",
    "db:backup:encrypted": "node scripts/managed-backup.mjs backup",
    "db:restore": "node scripts/docker-db.mjs restore",
    "sync:project": "node scripts/sync-project.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "16.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "concurrently": "9.2.5",
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "8.16.3",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "@prisma/config": {
      "effect": "3.22.1"
    }
  }
}
