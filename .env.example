NODE_ENV=development
# Docker host ports; keep DATABASE_URL / REDIS_URL in sync if changed.
POSTGRES_PASSWORD=milo_local
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://milo:milo_local@127.0.0.1:5432/milo?schema=public
REDIS_URL=redis://127.0.0.1:6379
APP_URL=http://localhost:3000
API_PORT=4000
# Local default is loopback; container-only API uses 0.0.0.0 behind ingress.
API_HOST=127.0.0.1
# Explicit proxy IPs/CIDRs only. Empty means forwarding headers are not trusted.
TRUST_PROXY=
# Production API docs are off unless enabled, then require an Admin session.
ENABLE_API_DOCS=false
BRAND_NAME=MILOSHOPHAND
# npm run setup generates fresh secrets; never reuse in production.
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
DEV_WEBHOOK_SECRET=
# mock is development-only, not a provider sandbox.
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
QR_TTL_MINUTES=15
COD_CONFIRM_HOURS=48
COD_MAX_VND=3000000
RETURN_DAYS=14
FREE_SHIPPING_MIN_VND=699000
SHIPPING_FLAT_VND=30000
# file writes development mail to .local/mail; production must use smtp.
EMAIL_PROVIDER=file
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MILOSHOPHAND <hello@localhost>
# Gmail SMTP: set EMAIL_PROVIDER=smtp, SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=<your Gmail>,
# SMTP_PASSWORD=<Google App Password; not the normal Gmail password>.
# Google OAuth: Web application client, secrets stay on API only.
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
# On Production, register the same /api/v1/auth/google/callback under APP_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
GHN_TOKEN=
GHN_SHOP_ID=
GHN_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Private return photos, outside the public uploads directory.
RETURN_UPLOAD_DIR=.local/return-images

# Direct virtual try-on: OpenAI API billing is separate from ChatGPT Plus.
# No API request can be sent until explicitly enabled AND a server key is set.
TRY_ON_ENABLED=false
# Temporarily optional for AI try-on only. Set true on API and worker to restore.
TRY_ON_REQUIRE_VERIFIED_EMAIL=false
OPENAI_API_KEY=
TRY_ON_MODEL=gpt-image-2.5-sunburst
# Fixed: 2 outputs/request, maximum 2 images/account/day in Vietnam time.
# Additional shop-wide daily image cap; not a USD spend guarantee.
TRY_ON_SHOP_DAILY_IMAGES=20
TRY_ON_RETENTION_HOURS=24
TRY_ON_TIMEOUT_MS=180000
# API and worker must share this private volume, outside all public uploads.
TRY_ON_PRIVATE_DIR=.local/try-on-private

# Optional dedicated JWT signing secret (>=64 random characters).
# If empty, a separate signing key is derived from SESSION_SECRET.
JWT_SECRET=
# Server-side Cloudinary credentials. Never prefix with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Managed backup: separate absolute mounted destination; do not put keys in Git.
# The command does not create a schedule or delete previous backups.
BACKUP_DESTINATION=
BACKUP_ENCRYPTION_KEY=
