NODE_ENV=development
# Docker host ports; keep DATABASE_URL / REDIS_URL in sync if changed.
POSTGRES_PASSWORD=milo_local
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://milo:milo_local@localhost:5432/milo?schema=public
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
API_PORT=4000
BRAND_NAME=MILOSHOPHAND
# npm run setup generates fresh secrets; never reuse in production.
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
DEV_WEBHOOK_SECRET=
# mock is development-only, not a provider sandbox.
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
QR_TTL_MINUTES=15
COD_CONFIRM_HOURS=48
COD_MAX_VND=3000000
RETURN_DAYS=14
FREE_SHIPPING_MIN_VND=699000
SHIPPING_FLAT_VND=30000
# file writes development mail to .local/mail; production must use smtp.
EMAIL_PROVIDER=file
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MILOSHOPHAND <hello@localhost>
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
GHN_TOKEN=
GHN_SHOP_ID=
GHN_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Private return photos, outside the public uploads directory.
RETURN_UPLOAD_DIR=.local/return-images
